<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar atendimento"
            android:textColor="@color/azul"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Situação do atendimento" android:textColor="@color/texto" android:textStyle="bold" />
        <Spinner android:id="@+id/spSituacaoAtendimento" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <EditText android:id="@+id/etConteudoTratado" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="16dp" android:gravity="top" android:hint="Conteúdo ou assunto tratado" android:inputType="textMultiLine" android:padding="13dp" android:background="@drawable/bg_input" />
        <EditText android:id="@+id/etObservacoesAtendimento" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="12dp" android:gravity="top" android:hint="Observações" android:inputType="textMultiLine" android:padding="13dp" android:background="@drawable/bg_input" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Presença dos alunos" android:textColor="@color/texto" android:textSize="18sp" android:textStyle="bold" />

        <ListView
            android:id="@+id/lvPresencaAlunos"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:divider="@color/borda"
            android:dividerHeight="1dp" />

        <Button android:id="@+id/btnSalvarRegistro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Salvar registro" android:textAllCaps="false" android:backgroundTint="@color/azul" />
    </LinearLayout>
</ScrollView>
