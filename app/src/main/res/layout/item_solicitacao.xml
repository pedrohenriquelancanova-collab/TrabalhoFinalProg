<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemSolicitacao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/tvItemSolicitante" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aluno: Nome" android:textColor="@color/texto" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvItemResumoSolicitacao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Disciplina e data desejada" android:textColor="@color/texto_secundario" />
    <TextView android:id="@+id/tvItemStatusSolicitacao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pendente" android:textColor="@color/azul" />
</LinearLayout>
