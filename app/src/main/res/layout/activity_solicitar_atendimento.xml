<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solicitar atendimento"
            android:textColor="@color/azul"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Professor" android:textStyle="bold" android:textColor="@color/texto" />
        <Spinner android:id="@+id/spProfessor" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Disciplina" android:textStyle="bold" android:textColor="@color/texto" />
        <Spinner android:id="@+id/spDisciplina" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tipo de atendimento" android:textStyle="bold" android:textColor="@color/texto" />
        <Spinner android:id="@+id/spTipoAtendimento" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Data desejada" android:textStyle="bold" android:textColor="@color/texto" />
        <EditText android:id="@+id/etDataDesejada" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="DD/MM/AAAA" android:focusable="false" android:clickable="true" android:padding="13dp" android:background="@drawable/bg_input" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Horário disponível" android:textStyle="bold" android:textColor="@color/texto" />
        <Spinner android:id="@+id/spHorarioDisponivel" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Modalidade" android:textStyle="bold" android:textColor="@color/texto" />
        <RadioGroup android:id="@+id/rgModalidade" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbPresencial" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Presencial" android:checked="true" />
            <RadioButton android:id="@+id/rbRemoto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Remoto" />
        </RadioGroup>

        <EditText android:id="@+id/etDescricaoSolicitacao" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="12dp" android:gravity="top" android:hint="Descreva sua dúvida ou objetivo" android:inputType="textMultiLine" android:padding="13dp" android:background="@drawable/bg_input" />

        <Button android:id="@+id/btnEnviarSolicitacao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Enviar solicitação" android:textAllCaps="false" android:backgroundTint="@color/azul" />
    </LinearLayout>
</ScrollView>
