<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Minha disponibilidade"
            android:textColor="@color/azul"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Defina os períodos em que os alunos poderão solicitar atendimento."
            android:textColor="@color/texto_secundario" />

        <Spinner
            android:id="@+id/spDiaSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Horário inicial" android:textColor="@color/texto" android:textStyle="bold" />
        <EditText android:id="@+id/etHorarioInicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="08:00" android:inputType="time" android:padding="13dp" android:background="@drawable/bg_input" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Horário final" android:textColor="@color/texto" android:textStyle="bold" />
        <EditText android:id="@+id/etHorarioFim" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="10:00" android:inputType="time" android:padding="13dp" android:background="@drawable/bg_input" />

        <Button android:id="@+id/btnAdicionarDisponibilidade" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Adicionar horário" android:textAllCaps="false" android:backgroundTint="@color/azul" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Horários cadastrados" android:textColor="@color/texto" android:textSize="18sp" android:textStyle="bold" />

        <ListView
            android:id="@+id/lvDisponibilidades"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"
            android:divider="@color/borda"
            android:dividerHeight="1dp" />
    </LinearLayout>
</ScrollView>
